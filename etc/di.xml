<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Framework\GraphQlSchemaStitching\GraphQlReader">
        <plugin name="Yireo_GraphQlSchemaManipulation::manipulateSchemaConfig"
                type="Yireo\GraphQlSchemaManipulation\Plugin\ManipulateSchemaConfig"/>
    </type>

    <type name="Magento\Framework\GraphQl\Config\Element\FieldsFactory">
        <plugin name="Yireo_GraphQlSchemaManipulation::addSchemaManipulators"
                type="Yireo\GraphQlSchemaManipulation\Plugin\AddSchemaManipulators"/>
    </type>

    <type name="Magento\Framework\GraphQl\Config\Element\InterfaceFactory">
        <plugin name="Yireo_GraphQlSchemaManipulation::addInterfaceSchemaManipulators"
                type="Yireo\GraphQlSchemaManipulation\Plugin\AddInterfaceSchemaManipulators"/>
    </type>
</config>
